{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.env.linux": {
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "VIRTUAL_ENV_DISABLE_PROMPT": "1"
    },
    "files.exclude": {
        ".venv": true,
        "tools": true,
        "refs": true,
        ".runops/knowledge": true,
        ".runops/environment.toml": true,
        "runs/**/work": true,
        "runs/**/status": true,
        "runs/**/input/plasma.inp": true,
        "runs/**/submit": true,
        "runs/**/manifest.toml": true
    },
    "search.exclude": {
        ".venv": true,
        "tools": true,
        "refs": true,
        ".runops/knowledge": true,
        "runs/**/work": true,
        "runs/**/status": true,
        "runs/**/input/plasma.inp": true,
        "runs/**/submit": true,
        "runs/**/manifest.toml": true,
        "materials/**/*.pdf": true
    },
    "files.watcherExclude": {
        ".venv/**": true,
        "tools/**": true,
        "refs/**": true,
        ".runops/knowledge/**": true,
        "runs/**/work/**": true,
        "runs/**/status/**": true,
        "runs/**/submit/**": true
    },
    "python.analysis.exclude": [
        ".venv",
        "tools",
        "refs",
        ".runops/knowledge",
        "runs/**/work",
        "runs/**/status",
        "runs/**/submit"
    ]
}
