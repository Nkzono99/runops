# Codex CLI project-local config for runops project '{{ project_name }}'.
#
# Codex auto-loads this file when the project is marked trusted in
# ~/.codex/config.toml:
#
#   [projects."<absolute path to this project>"]
#   trust_level = "trusted"
#
# See .codex/README.md for the full wiring guide.

# Keep this file to repo-stable defaults. Runtime-sensitive options
# such as approval and network policy belong in the Codex runtime or
# user-local config; see .codex/README.md for the responsibility split.

# Sandbox: workspace-write allows edits inside the project root and
# protects writes outside the tree.
sandbox_mode = "workspace-write"

# Keep AGENTS.md compact; detailed simulator workflow should live in
# .agents/skills/, generated knowledge, or directory-specific AGENTS.md files.
project_doc_max_bytes = 32768
