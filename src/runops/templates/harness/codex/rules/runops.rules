# Codex execpolicy rules for runops projects.
#
# These rules apply when Codex asks to run a command outside the sandbox.
# Keep behavioral workflow guidance in AGENTS.md; this file only captures
# high-cost or irreversible command prefixes that should not be silently escalated.
#
# Codex execpolicy is prefix-based.  Submit is intentionally allowed at the
# permission layer so Codex does not route around a blocked `--all` command by
# issuing many individual submits.  The required safety contract lives in
# AGENTS.md / skills: bounded pilots stay within the user-authorized scope;
# bulk/full submits require dry-run review and the documented human checkpoint.

prefix_rule(
    pattern = ["runo", "runs", "submit", "--dry-run"],
    decision = "allow",
    justification = "Dry-run only reports what would be submitted and does not spend HPC resources.",
    match = [
        "runo runs submit --dry-run R20260419-0001",
        "runo runs submit --dry-run --all runs/survey",
    ],
)

prefix_rule(
    pattern = ["runops", "runs", "submit", "--dry-run"],
    decision = "allow",
    justification = "Dry-run only reports what would be submitted and does not spend HPC resources.",
    match = [
        "runops runs submit --dry-run R20260419-0001",
        "runops runs submit --dry-run --all runs/survey",
    ],
)

prefix_rule(
    pattern = ["uvx", "--from", "runops", "runo", "runs", "submit", "--dry-run"],
    decision = "allow",
    justification = "Dry-run only reports what would be submitted and does not spend HPC resources.",
    match = [
        "uvx --from runops runo runs submit --dry-run R20260419-0001",
        "uvx --from runops runo runs submit --dry-run --all runs/survey",
    ],
)

prefix_rule(
    pattern = ["uvx", "--from", "runops", "runops", "runs", "submit", "--dry-run"],
    decision = "allow",
    justification = "Dry-run only reports what would be submitted and does not spend HPC resources.",
    match = [
        "uvx --from runops runops runs submit --dry-run R20260419-0001",
        "uvx --from runops runops runs submit --dry-run --all runs/survey",
    ],
)

prefix_rule(
    pattern = ["runo", "runs", "submit"],
    decision = "allow",
    justification = "Agents may submit Slurm jobs within the user-authorized bounded scope.",
    match = [
        "runo runs submit R20260419-0001",
        "runo runs submit --all runs/survey",
        "runo runs submit -qn gr10451a R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["runops", "runs", "submit"],
    decision = "allow",
    justification = "Agents may submit Slurm jobs within the user-authorized bounded scope.",
    match = [
        "runops runs submit R20260419-0001",
        "runops runs submit --all runs/survey",
        "runops runs submit -qn gr10451a R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["uvx", "--from", "runops", "runo", "runs", "submit"],
    decision = "allow",
    justification = "Agents may submit Slurm jobs within the user-authorized bounded scope.",
    match = [
        "uvx --from runops runo runs submit R20260419-0001",
        "uvx --from runops runo runs submit --all runs/survey",
        "uvx --from runops runo runs submit -qn gr10451a R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["uvx", "--from", "runops", "runops", "runs", "submit"],
    decision = "allow",
    justification = "Agents may submit Slurm jobs within the user-authorized bounded scope.",
    match = [
        "uvx --from runops runops runs submit R20260419-0001",
        "uvx --from runops runops runs submit --all runs/survey",
        "uvx --from runops runops runs submit -qn gr10451a R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["runo", "runs", "purge-work"],
    decision = "prompt",
    justification = "Purging work/ deletes generated run outputs.",
    match = [
        "runo runs purge-work R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["runops", "runs", "purge-work"],
    decision = "prompt",
    justification = "Purging work/ deletes generated run outputs.",
    match = [
        "runops runs purge-work R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["runo", "runs", "delete"],
    decision = "prompt",
    justification = "Deleting a run removes its directory.",
    match = [
        "runo runs delete R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["runops", "runs", "delete"],
    decision = "prompt",
    justification = "Deleting a run removes its directory.",
    match = [
        "runops runs delete R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Avoid broad recursive deletion; use runops cleanup commands.",
    match = [
        "rm -rf runs/R20260419-0001",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared history.",
    match = [
        "git push --force",
        "git push --force origin main",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset discards local work.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
)
