# Codex execpolicy rules for the runops development repository.
#
# Only high-cost or irreversible command prefixes live here. Workflow guidance is
# in AGENTS.md, .claude/rules/*.md and .agents/skills/.

prefix_rule(
    pattern = ["runo", "submit"],
    decision = "prompt",
    justification = "Submitting spends HPC allocation; confirm targets and resources first.",
    match = ["runo submit R20261015-0001", "runo submit --all runs/case"],
)

prefix_rule(
    pattern = ["uv", "run", "runo", "submit"],
    decision = "prompt",
    justification = "Submitting spends HPC allocation; confirm targets and resources first.",
    match = ["uv run runo submit R20261015-0001"],
)

prefix_rule(
    pattern = ["runo", "delete"],
    decision = "prompt",
    justification = "Deleting a run removes its directory.",
    match = ["runo delete R20261015-0001"],
)

prefix_rule(
    pattern = ["runo", "tidy", "--apply"],
    decision = "prompt",
    justification = "tidy --apply deletes or archives runs.",
    match = ["runo tidy --apply", "runo tidy --apply --only expired-scratch"],
)

prefix_rule(
    pattern = ["runo", "migrate-v1"],
    decision = "prompt",
    justification = "Migration rewrites a project; run --dry-run and review first.",
    match = ["runo migrate-v1 -y"],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Avoid broad recursive deletion; use runo delete / tidy.",
    match = ["rm -rf runs/case"],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "allow",
    justification = "runops is main-first; push only after local quality gates and when the user asked.",
    match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared history.",
    match = ["git push --force", "git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset discards local work.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)
