{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "survey.toml",
  "description": "Parameter survey definition for runops",
  "type": "object",
  "required": ["survey"],
  "properties": {
    "survey": {
      "type": "object",
      "required": ["base_case", "simulator", "launcher"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Survey identifier, e.g. S20260327-cavity-u-a"
        },
        "name": {
          "type": "string",
          "description": "Human-readable survey name"
        },
        "experiment_id": {
          "type": "string",
          "pattern": "^E\\d{8}-\\d{4}$",
          "description": "Owning Experiment ID for bounded materialization"
        },
        "phase": {
          "type": "string",
          "enum": ["pilot", "main", "followup"]
        },
        "base_case": {
          "type": "string",
          "description": "Case name to derive runs from"
        },
        "simulator": {
          "type": "string",
          "description": "Simulator entry name from simulators.toml"
        },
        "launcher": {
          "type": "string",
          "description": "Launcher profile name from launchers.toml"
        }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "description": "Scientific intent frozen into materialized run manifests",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": ["explore", "confirm", "validate", "reproduce"]
        },
        "information_gap": {"type": "string", "minLength": 1},
        "baseline_run": {
          "type": "string",
          "pattern": "^R\\d{8}-\\d{4}$"
        },
        "created_by": {"type": "string", "minLength": 1},
        "goal_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "description": "Survey-local materialization envelope",
      "properties": {
        "max_materialized_runs": {"type": "integer", "minimum": 1},
        "max_core_hours": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "retention": {
      "type": "object",
      "description": "Review hints; expiry is not automatic delete authority",
      "properties": {
        "class": {"type": "string", "minLength": 1},
        "review_after": {"type": "string", "minLength": 1},
        "expire_after": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "description": "Optional metadata overlay for generated runs",
      "properties": {
        "model": { "type": "string" },
        "submodel": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "axes": {
      "type": "object",
      "description": "Cartesian product parameter axes. Keys may use dot notation.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1
      }
    },
    "linked": {
      "type": "array",
      "description": "Co-varying parameter groups. Values in each group are zipped.",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "naming": {
      "type": "object",
      "description": "Naming configuration for generated runs",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Optional template for run display names; when empty, labels are generated from parameter changes"
        },
        "directory": {
          "type": "string",
          "default": "{run_id}--{label}",
          "description": "Run directory basename template containing {run_id} and optionally {label}"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 48,
          "description": "Maximum semantic label length in directory names"
        },
        "aliases": {
          "type": "object",
          "description": "Human-readable aliases for parameter keys",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "groups": {
          "type": "array",
          "description": "Parameter groups that may collapse into one semantic label",
          "items": {
            "type": "object",
            "required": ["label", "keys"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "strategy": {
                "type": "string",
                "enum": ["uniform_ratio"],
                "default": "uniform_ratio"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "description": "Partial job overlay applied to the base case job section",
      "properties": {
        "partition": { "type": "string" },
        "nodes": { "type": "integer" },
        "ntasks": { "type": "integer" },
        "walltime": {
          "type": "string",
          "pattern": "^(?!0+(?:-0+)?:00:00$)(?:[0-9]+-)?[0-9]+:[0-5][0-9]:[0-5][0-9]$"
        },
        "processes": { "type": "integer" },
        "threads": { "type": "integer" },
        "cores": { "type": "integer" },
        "memory": { "type": "string" },
        "gpus": { "type": "integer" },
        "qos": { "type": "string" },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pre_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "post_commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
