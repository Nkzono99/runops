{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "survey.toml",
  "description": "Parameter survey definition for runops",
  "type": "object",
  "required": ["survey"],
  "properties": {
    "survey": {
      "type": "object",
      "required": ["base_case", "simulator", "launcher"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Survey identifier, e.g. S20260327-cavity-u-a"
        },
        "name": {
          "type": "string",
          "description": "Human-readable survey name"
        },
        "base_case": {
          "type": "string",
          "description": "Case name to derive runs from"
        },
        "simulator": {
          "type": "string",
          "description": "Simulator entry name from simulators.toml"
        },
        "launcher": {
          "type": "string",
          "description": "Launcher profile name from launchers.toml"
        }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "description": "Optional metadata overlay for generated runs",
      "properties": {
        "model": { "type": "string" },
        "submodel": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "axes": {
      "type": "object",
      "description": "Cartesian product parameter axes. Keys may use dot notation.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1
      }
    },
    "linked": {
      "type": "array",
      "description": "Co-varying parameter groups. Values in each group are zipped.",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "naming": {
      "type": "object",
      "description": "Naming configuration for generated runs",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Template for run display names"
        }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "description": "Partial job overlay applied to the base case job section",
      "properties": {
        "partition": { "type": "string" },
        "nodes": { "type": "integer" },
        "ntasks": { "type": "integer" },
        "walltime": { "type": "string" },
        "processes": { "type": "integer" },
        "threads": { "type": "integer" },
        "cores": { "type": "integer" },
        "memory": { "type": "string" },
        "gpus": { "type": "integer" },
        "qos": { "type": "string" },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pre_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "post_commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
