{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "manifest.toml",
  "description": "Run manifest, the source of truth for a runops run",
  "type": "object",
  "required": [
    "run",
    "origin",
    "simulator",
    "launcher",
    "simulator_source",
    "job",
    "params_snapshot"
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R\\d{8}-\\d{4}$"
        },
        "display_name": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "submitted",
            "running",
            "completed",
            "failed",
            "cancelled",
            "archived",
            "purged"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "failure_reason": { "type": "string" },
        "last_slurm_state": { "type": "string" }
      },
      "additionalProperties": true
    },
    "path": {
      "type": "object",
      "properties": {
        "run_dir": { "type": "string" }
      },
      "additionalProperties": true
    },
    "origin": {
      "type": "object",
      "required": ["case"],
      "properties": {
        "case": { "type": "string" },
        "survey": { "type": "string" },
        "parent_run": { "type": "string" }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "submodel": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "simulator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "adapter": { "type": "string" },
        "resolver_mode": {
          "type": "string",
          "enum": ["local_executable", "local_source", "package"]
        }
      },
      "additionalProperties": true
    },
    "launcher": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "simulator_source": {
      "type": "object",
      "description": "Simulator runtime and source provenance",
      "properties": {
        "resolver_mode": { "type": "string" },
        "executable": { "type": "string" },
        "exe_hash": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "executable_hash": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        },
        "git_commit": { "type": "string" },
        "git_dirty": { "type": "boolean" },
        "git_state_observed": { "type": "boolean" },
        "source_repo": { "type": "string" },
        "build_command": { "type": "string" },
        "package_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "description": "Scheduler job configuration and latest submission state",
      "required": ["scheduler", "job_id", "submitted_at"],
      "properties": {
        "scheduler": { "type": "string" },
        "job_id": { "type": "string" },
        "partition": { "type": "string" },
        "nodes": { "type": "integer" },
        "ntasks": { "type": "integer" },
        "processes": { "type": "integer" },
        "threads": { "type": "integer" },
        "cores": { "type": "integer" },
        "memory": { "type": "string" },
        "gpus": { "type": "integer" },
        "qos": { "type": "string" },
        "walltime": {
          "type": "string",
          "pattern": "^(?!0+(?:-0+)?:00:00$)(?:[0-9]+-)?[0-9]+:[0-5][0-9]:[0-5][0-9]$"
        },
        "submitted_at": { "type": "string" },
        "attempt": { "type": "integer" },
        "queue": { "type": "string" },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "variation": {
      "type": "object",
      "properties": {
        "changed_keys": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "params_snapshot": {
      "type": "object",
      "description": "Full parameter snapshot frozen at run creation",
      "additionalProperties": true
    },
    "files": {
      "type": "object",
      "properties": {
        "input_dir": { "type": "string" },
        "submit_dir": { "type": "string" },
        "work_dir": { "type": "string" },
        "analysis_dir": { "type": "string" },
        "status_dir": { "type": "string" }
      },
      "additionalProperties": true
    },
    "intent": {
      "type": "object",
      "description": "Experiment and Survey intent frozen at materialization",
      "properties": {
        "experiment_id": {
          "type": "string",
          "pattern": "^E\\d{8}-\\d{4}$"
        },
        "survey_id": {"type": "string"},
        "phase": {
          "type": "string",
          "enum": ["pilot", "main", "followup"]
        },
        "purpose": {
          "type": "string",
          "enum": ["explore", "confirm", "validate", "reproduce"]
        },
        "created_by": {"type": "string"},
        "goal_id": {"type": "string"},
        "information_gap": {"type": "string"},
        "baseline_run": {
          "type": "string",
          "pattern": "^R\\d{8}-\\d{4}$"
        }
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "description": "Deterministic scientific and execution identities",
      "properties": {
        "point_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "condition_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scientific_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "provenance_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "curation": {
      "type": "object",
      "description": "Run review metadata; Result links own evidence selection",
      "properties": {
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "reviewed"]
        },
        "reviewed_at": {"type": "string"},
        "reviewed_by": {"type": "string"},
        "reason": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "required": ["review_status"],
            "properties": {"review_status": {"const": "reviewed"}}
          },
          "then": {
            "required": ["reviewed_at", "reviewed_by", "reason"],
            "properties": {
              "reviewed_at": {
                "minLength": 1,
                "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              "reviewed_by": {"minLength": 1},
              "reason": {"minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "description": "Storage tier and representation form, independent of run state",
      "properties": {
        "tier": {"type": "string", "enum": ["hot", "cold"]},
        "form": {
          "type": "string",
          "enum": ["full", "compacted", "metadata_only"]
        },
        "retention_class": {"type": "string"},
        "review_after": {"type": "string"},
        "expire_after": {"type": "string"},
        "pinned": {"type": "boolean"},
        "pin_reason": {"type": "string"},
        "protected_by_results": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R[0-9]{4}-[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
