{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "case.toml",
  "description": "Reusable case template definition for runops",
  "type": "object",
  "required": ["case"],
  "properties": {
    "case": {
      "type": "object",
      "required": ["name", "simulator", "launcher"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Case name"
        },
        "simulator": {
          "type": "string",
          "description": "Simulator entry name from simulators.toml"
        },
        "launcher": {
          "type": "string",
          "description": "Launcher profile name from launchers.toml"
        },
        "description": {
          "type": "string",
          "description": "Case description"
        }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "description": "Metadata for organizing runs",
      "properties": {
        "model": { "type": "string" },
        "submodel": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "job": {
      "type": "object",
      "description": "Scheduler job parameters for runs created from this case",
      "properties": {
        "partition": { "type": "string" },
        "nodes": { "type": "integer" },
        "ntasks": { "type": "integer" },
        "sockets": { "type": "integer" },
        "mpiprocs": { "type": "integer" },
        "ompthreads": { "type": "integer" },
        "group": { "type": "string" },
        "walltime": { "type": "string" },
        "processes": { "type": "integer" },
        "threads": { "type": "integer" },
        "cores": { "type": "integer" },
        "memory": { "type": "string" },
        "gpus": { "type": "integer" },
        "qos": { "type": "string" },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pre_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "post_commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "params": {
      "type": "object",
      "description": "Default simulator parameters",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
