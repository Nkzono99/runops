{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "runops.toml",
  "description": "runops project configuration",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "description": "Project description"
        },
        "codex_plugins": {
          "type": "object",
          "description": "Project-wide external Codex plugin recommendations",
          "additionalProperties": {
            "$ref": "codex-plugin-recommendation.json"
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "description": "Knowledge integration configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether knowledge integration is active"
        },
        "mount_dir": {
          "type": "string",
          "default": "refs/knowledge",
          "description": "Base directory for mounting knowledge sources"
        },
        "derived_dir": {
          "type": "string",
          "default": ".runops/knowledge",
          "description": "Directory for generated/derived knowledge files"
        },
        "auto_sync_on_setup": {
          "type": "boolean",
          "default": true,
          "description": "Sync knowledge sources during runops setup"
        },
        "generate_claude_imports": {
          "type": "boolean",
          "default": true,
          "description": "Generate CLAUDE.md import stubs for enabled profiles"
        },
        "sources": {
          "type": "array",
          "description": "External knowledge sources",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Source identifier"
              },
              "type": {
                "type": "string",
                "enum": ["git", "path"],
                "description": "Source type"
              },
              "kind": {
                "type": "string",
                "enum": ["profiles", "project", "insights"],
                "description": "Source content kind"
              },
              "url": {
                "type": "string",
                "description": "Git URL for git-type sources"
              },
              "path": {
                "type": "string",
                "description": "Filesystem path for path-type sources"
              },
              "ref": {
                "type": "string",
                "default": "main",
                "description": "Git ref to checkout"
              },
              "mount": {
                "type": "string",
                "description": "Relative mount path from project root"
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Enabled profile names from this source"
              }
            }
          }
        }
      }
    },
    "research": {
      "type": "object",
      "description": "Quantity-bounded research workspace options",
      "properties": {
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current_chars": {"type": "integer", "minimum": 1, "default": 20000},
            "current_lines": {"type": "integer", "minimum": 1, "default": 50},
            "current_path_references": {"type": "integer", "minimum": 1, "default": 10},
            "current_chronological_headings": {"type": "integer", "minimum": 1, "default": 3},
            "journal_segment_chars": {"type": "integer", "minimum": 1, "default": 64000},
            "result_readme_chars": {"type": "integer", "minimum": 1, "default": 30000},
            "active_results": {"type": "integer", "minimum": 1, "default": 8},
            "result_artifact_files": {"type": "integer", "minimum": 1, "default": 50},
            "result_artifact_bytes": {"type": "integer", "minimum": 1, "default": 209715200}
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
